{
	"version": 3,
	"routes": [
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/g/?(?:/__data.json)?$",
			"dest": "/g"
		},
		{
			"src": "^/g/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/g/[groupid]"
		},
		{
			"src": "^/inspector/?(?:/__data.json)?$",
			"dest": "/inspector"
		},
		{
			"src": "^/inspector/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/inspector/[groupid]"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}